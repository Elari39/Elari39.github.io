{
  "name": "ashen-grimoire",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Ashen Witch's Grimoire —— 灰烬女巫的魔典：四个自建项目的条目库",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit && astro check",
    "guard": "node scripts/check-site.mjs",
    "assert:budgets": "node scripts/assert-budgets.mjs",
    "verify": "pnpm run check && pnpm run build && pnpm run guard && pnpm run assert:budgets && pnpm run test:guard && pnpm run test:assets",
    "verify:browser": "node scripts/verify-browser.mjs",
    "assets": "python scripts/prepare-assets.py",
    "assets:inspect": "python scripts/prepare-assets.py --inspect",
    "astro": "astro",
    "test:guard": "node --test scripts/*.test.mjs",
    "test:assets": "python -m unittest discover -s scripts -p test_assets.py",
    "verify:browser:local": "node scripts/run-browser.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "image-size": "^2.0.4",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  }
}
