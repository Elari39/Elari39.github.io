---
import { getCollection, render } from 'astro:content';

import Glyph from '../../components/Glyph.astro';
import BrandMark from '../../components/BrandMark.astro';
import BackToEntries from '../../components/BackToEntries.astro';
import Toc from '../../components/Toc.astro';
import { SITE } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PLATE_SIZES } from '../../data/plates';
import { entryNumber, statusLabel } from '../../lib/entry';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;

/** 前后条目：魔典该有的翻页 */
const ordered = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const position = ordered.findIndex((item) => item.id === entry.id);
const previous = position > 0 ? ordered[position - 1] : undefined;
const next = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;

/** 图版带上真实像素尺寸渲染，图片加载完成前就把位置占住（避免跳版） */
const plates = data.gallery.map((plate) => ({
  ...plate,
  size: PLATE_SIZES[plate.src.replace(/^\//, '')],
}));

/**
 * 目录 = 模板里的三个分区 + 正文里的小标题（h2 / h3）。
 * 后者来自 render() 返回的 headings —— 构建期就知道，所以纯静态 HTML
 * 就能跳转，不需要 scrollspy，也就不需要任何客户端 JS。
 * 三个分区标题的 id 写在下面的模板里，守卫会核对每个 #锚点都能落地。
 */
const tocItems = [
  { id: 'highlights', text: '为什么值得一看', depth: 2 },
  { id: 'stack', text: '技术概览', depth: 2 },
  ...(plates.length > 0 ? [{ id: 'plates', text: '图版', depth: 2 }] : []),
  ...headings
    .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    .map((heading) => ({ id: heading.slug, text: heading.text, depth: heading.depth })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: data.title,
  description: data.summary,
  url: `${SITE.url}/projects/${entry.id}/`,
  codeRepository: data.links.repo,
  inLanguage: SITE.lang,
  author: {
    '@type': 'Person',
    name: SITE.author.handle,
    url: SITE.author.github,
  },
  keywords: data.stack.join(', '),
};
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogType="article"
  accent={data.accent}
  jsonLd={jsonLd}
>
  <header class="entry-header relative overflow-hidden">
    {/* 章节水印是装饰；品牌标记与导航、页脚使用同一个来源。 */}
    <span class="entry-watermark" aria-hidden="true">{entryNumber(position)}</span>

    <div class="relative mx-auto max-w-5xl px-5 py-10">
      <div class="flex items-center justify-between gap-4">
        <BackToEntries />
        <BrandMark size={30} />
      </div>

      <div class="mt-5 flex items-start gap-4">
        <span class="glyph">
          <Glyph name={data.glyph} />
        </span>
        <div class="min-w-0">
          <h1 class="text-3xl sm:text-4xl">{data.title}</h1>
          <p class="mt-2 text-lg text-body">{data.tagline}</p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class={`badge badge-${data.status}`}>{statusLabel(data.status)}</span>
        <span class="chip">{data.year}</span>
        <span class="chip">{data.role}</span>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <a class="btn btn-primary" href={data.links.repo} rel="noopener noreferrer">GitHub 仓库</a>
        {
          data.links.live && (
            <a class="btn" href={data.links.live} rel="noopener noreferrer">
              访问线上站点
            </a>
          )
        }
      </div>
    </div>
  </header>

  {/* 纯色书页承载长文，网格只留在页边；右侧目录在同一网格内吸附。 */}
  <div class="reading-layout mx-auto max-w-5xl px-5 py-10">
    <div class="reading-sheet">
      <details class="mobile-toc mb-8 xl:hidden">
        <summary>本页目录</summary>
        <Toc items={tocItems} showTitle={false} />
      </details>
      <p class="border-l-2 border-primary pl-4 text-lg text-ink">{data.summary}</p>

      <section id="highlights" class="mt-10">
        <h2 class="text-xl">为什么值得一看</h2>
        <ul class="mt-4 space-y-3">
          {
            data.highlights.map((highlight) => (
              <li class="flex gap-3 text-body">
                <span class="mt-[0.6em] h-px w-4 flex-none bg-primary" aria-hidden="true" />
                <span>{highlight}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="stack" class="mt-10">
        <h2 class="text-xl">技术概览</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {data.stack.map((item) => <span class="chip">{item}</span>)}
        </div>
      </section>

      {
        plates.length > 0 && (
          <section id="plates" class="mt-12">
            <h2 class="text-xl">图版</h2>
            <div class="mt-5 space-y-8">
              {plates.map((plate) => (
                <figure class={`plate-figure plate-width-${plate.size?.width}`}>
                  <a href={plate.src} aria-label={`查看原图：${plate.alt}`}>
                  <img
                    class="plate"
                    src={plate.src}
                    alt={plate.alt}
                    loading="lazy"
                    decoding="async"
                    width={plate.size?.width}
                    height={plate.size?.height}
                  />
                  </a>
                  {plate.caption && (
                    <figcaption class="mt-3 text-sm text-muted">{plate.caption}</figcaption>
                  )}
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <article class="prose-grimoire mt-12">
        <Content />
      </article>

      <nav
        class="mt-16 grid gap-4 border-t border-hairline pt-8 sm:grid-cols-2"
        aria-label="条目翻页"
      >
        {
          previous ? (
            <a
              href={`/projects/${previous.id}/`}
              class="rounded-card border border-hairline p-4 no-underline transition-colors hover:border-primary-ink"
            >
              <span class="label">上一条 · {entryNumber(position - 1)}</span>
              <span class="mt-1 block font-display text-lg text-ink">{previous.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" aria-hidden="true" />
          )
        }
        {
          next && (
            <a
              href={`/projects/${next.id}/`}
              class="rounded-card border border-hairline p-4 no-underline transition-colors hover:border-primary-ink sm:text-right"
            >
              <span class="label">下一条 · {entryNumber(position + 1)}</span>
              <span class="mt-1 block font-display text-lg text-ink">{next.data.title}</span>
            </a>
          )
        }
      </nav>
      <div class="mt-8"><BackToEntries /></div>
    </div>
    <aside class="hidden xl:block"><Toc items={tocItems} /></aside>
  </div>
</BaseLayout>
