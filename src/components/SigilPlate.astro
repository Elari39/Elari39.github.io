---
/**
 * 尺规化的符文阵：外轨 → 四象符文 → 刻度 → 八芒封缄 → 余烬。
 * 主线直接描边，避免渐变与多层 opacity 相乘后在浅色画布上消失。
 * 全部是构建期几何与 CSS 动效，不增加客户端脚本或资源请求。
 */
interface Props {
  /** 404 的 144px 小图使用更粗的线。 */
  weight?: number;
}

const { weight = 1 } = Astro.props;

/** 极坐标，圆心 100,100，0° 指向正上方。 */
function point(radius: number, angleDeg: number): [number, number] {
  const rad = ((angleDeg - 90) * Math.PI) / 180;
  return [100 + radius * Math.cos(rad), 100 + radius * Math.sin(rad)];
}
const round = (value: number) => value.toFixed(2);

const tickRing = Array.from({ length: 32 }, (_, index) => {
  const angle = (index * 360) / 32;
  const [x0, y0] = point(57, angle);
  const [x1, y1] = point(index % 4 === 0 ? 65 : index % 2 === 0 ? 62 : 60, angle);
  return `M${round(x0)} ${round(y0)}L${round(x1)} ${round(y1)}`;
}).join('');

/** 四段弧的缺口留给符文，让线条之间有明确的呼吸空间。 */
const runeArcs = [0, 90, 180, 270].map((center) => {
  const [x0, y0] = point(75, center - 34);
  const [x1, y1] = point(75, center + 34);
  return `M${round(x0)} ${round(y0)}A75 75 0 0 1 ${round(x1)} ${round(y1)}`;
}).join('');

const RUNE_MARK = 'M100 20V31M96 23.5h8M97.5 27.5h5';
const QUADRANTS = [45, 135, 225, 315];
---

<div class="hero-sigil" aria-hidden="true">
  <span class="hero-sigil__aura"></span>
  <svg
    viewBox="0 0 200 200"
    width="200"
    height="200"
    fill="none"
    stroke="currentColor"
    stroke-width={weight}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {/* 轻覆一层画布色，压住背景网格；中心封缄仍保持通透。 */}
    <circle class="hero-sigil__field" cx="100" cy="100" r="86" stroke="none"></circle>
    <circle cx="100" cy="100" r="86" opacity="0.46" stroke-width={weight * 0.8}></circle>
    <circle cx="100" cy="100" r="94" opacity="0.55" stroke-width={weight * 1.6}
      stroke-dasharray="0.1 24.51"></circle>

    {/* 四个定位菱形保持静止，给反向旋转的环提供视觉参照。 */}
    <g class="hero-sigil__accent" fill="currentColor" stroke="none">
      {[0, 90, 180, 270].map((angle) => (
        <path d="M100 9 103 14 100 19 97 14Z" transform={`rotate(${angle} 100 100)`} />
      ))}
    </g>

    <g class="hero-sigil__ticks" opacity="0.72">
      <path d={tickRing}></path>
    </g>

    <g class="hero-sigil__runes" stroke-width={weight * 1.15}>
      <path d={runeArcs} opacity="0.85"></path>
      {QUADRANTS.map((angle) => (
        <path d={RUNE_MARK} transform={`rotate(${angle} 100 100)`} />
      ))}
    </g>

    <g class="hero-sigil__seal">
      <path d="M100 54 146 100 100 146 54 100Z" stroke-width={weight * 1.3}></path>
      <path d="M100 54 146 100 100 146 54 100Z" opacity="0.6"
        transform="rotate(45 100 100)"></path>
      <circle cx="100" cy="100" r="26" opacity="0.8"></circle>
      <path d="M100 68V73M132 100H127M100 132V127M68 100H73" opacity="0.7"></path>
    </g>

    {/* 实色余烬替代模糊黑点；焰心使用主题的强调色前景。 */}
    <g class="hero-sigil__core hero-sigil__accent" stroke="none">
      <path d="M101 80C103 91 115 94 113 104C112 112 106 117 99 117C90 117 85 111 86 103C87 97 92 95 92 90C96 92 97 95 97 98C103 93 98 88 101 80Z"
        fill="currentColor"></path>
      <path class="hero-sigil__flame" d="M100 99C101 104 106 105 104 110C102 114 96 113 95 109C95 106 98 104 100 99Z"></path>
    </g>
  </svg>
</div>
