---
/**
 * 主题切换按钮。
 *
 * 图标不靠 JS 切换：两个 SVG 都在 DOM 里，由 global.css 里的
 * .theme-icon-sun / .theme-icon-moon 规则决定显示哪一个 —— 这样连
 * 「没 JS 时跟随系统」那种情况也能显示正确的图标。
 *
 * 这个 <script> 会被 Astro 打包成外链模块脚本（默认 defer），
 * 只注册点击事件，所以不需要同步执行，也不影响 CSP。
 */
---

<button
  id="theme-toggle"
  type="button"
  class="ml-1 grid h-9 w-9 place-items-center rounded-full border border-hairline bg-card text-muted transition-colors hover:border-primary hover:text-ink"
  aria-label="切换深色 / 浅色主题"
  title="切换深色 / 浅色主题"
>
  <svg
    class="theme-icon-sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6 6 18M18 6l1.6-1.6"></path>
  </svg>
  <svg
    class="theme-icon-moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8a8.6 8.6 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'grimoire-theme';
  const button = document.getElementById('theme-toggle');

  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

    root.dataset.theme = next;
    root.dataset.themeSource = 'manual';

    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* 存不下（隐私模式 / 被策略禁用）就只影响本次会话，不弹错 */
    }
  });
</script>
