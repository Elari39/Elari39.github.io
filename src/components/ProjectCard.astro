---
import type { ProjectView } from '../lib/entry';
import { entryNumber, statusLabel } from '../lib/entry';
import Glyph from './Glyph.astro';

interface Props {
  project: ProjectView;
  /** 在条目列表里的位置，用来渲染「条目 I / II / III」 */
  index: number;
}

const { project, index } = Astro.props;
const href = `/projects/${project.slug}/`;
/** 抽屉的 id：用 slug 拼，保证同一页里唯一（守卫会查 id 重复） */
const previewId = `preview-${project.slug}`;
---

<article class={`entry-card accent-${project.accent} overflow-hidden`}>
  {/* 程序化封面：accent 渐变 + 方格 + 章节水印。纯 CSS，不请求任何图片。
      整块是装饰，所以 aria-hidden。 */}
  <div class="cover" aria-hidden="true">
    <span class="cover-numeral">{entryNumber(index)}</span>
  </div>

  <div class="relative flex flex-1 flex-col p-6">
    <div class="flex items-start gap-4">
      <span class="glyph">
        <Glyph name={project.glyph} />
      </span>
      <div class="min-w-0 flex-1">
        <p class="label">条目 {entryNumber(index)}</p>
        <h3 class="mt-1 text-xl">
          <a href={href} class="text-ink no-underline hover:text-primary-ink">{project.title}</a>
        </h3>
      </div>
      <span class={`badge badge-${project.status}`}>{statusLabel(project.status)}</span>
    </div>

    <p class="mt-4 text-[0.9375rem] text-body">{project.tagline}</p>

    <ul class="mt-4 space-y-2 text-sm text-muted">
      {
        project.highlights.slice(0, 3).map((highlight) => (
          <li class="flex gap-2">
            <span class="text-primary" aria-hidden="true">
              —
            </span>
            <span>{highlight}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex flex-wrap gap-2">
      {project.stack.slice(0, 5).map((item) => <span class="chip">{item}</span>)}
      {
        project.stack.length > 5 && (
          <span class="chip" title={project.stack.join(' / ')}>
            +{project.stack.length - 5}
          </span>
        )
      }
    </div>

    <div class="mt-6 flex flex-wrap gap-2 border-t border-hairline pt-5">
      <a class="btn btn-primary" href={href}>翻开这一条</a>
      {
        project.links.live && (
          <a class="btn" href={project.links.live} rel="noopener noreferrer">
            线上演示
          </a>
        )
      }
      <a class="btn" href={project.links.repo} rel="noopener noreferrer">源码</a>
      {/* 就地预览：不离开首页、也不丢阅读位置。
          aria-haspopup 告诉辅助技术"这会打开一个对话框"，
          真正打开用的是原生 <dialog>.showModal()（见 src/scripts/interactions.ts）。 */}
      <button type="button" class="btn" data-preview={previewId} aria-haspopup="dialog" hidden>
        快速预览
      </button>
    </div>
  </div>

  {/*
    「就地预览」抽屉：原生 <dialog> + showModal()。
    用原生元素而不是自己糊一个遮罩，是因为焦点陷阱、Esc 关闭、把背景置为 inert、
    以及 ::backdrop 这些都由浏览器给 —— 我们只需要补两件事：打开，以及点背景关闭
    （原生 <dialog> 点背景并不会关）。

    里面全部用 preview__* 类名，刻意**不复用** .entry-card / .btn 这些既有类：
    一是首页的卡片计数断言按 .entry-card 数（复用会让数量翻倍），
    二是粗野主义那块无层级的 `[data-theme='brutal'] .btn` 覆盖会误命中抽屉内部。
  */}
  <dialog class="preview" id={previewId} aria-labelledby={`${previewId}-title`}>
    {/*
      tabindex="-1" + autofocus 是刻意的：showModal() 会把焦点给"第一个可聚焦后代"，
      也就是底部的「关闭预览」按钮 —— 浏览器为了让它进入视口，会把抽屉**向下滚一截**，
      于是抽屉一打开正好错过了自己的标题（实测：截图里看不到「条目 I · 就地预览」与项目名）。
      把焦点交给顶部这个容器就能停在开头；容器带 tabindex="-1"，所以它不进 Tab 序列，
      键盘用户按一下 Tab 仍然落在抽屉内部的第一个可操作元素上。
    */}
    <div class="preview__inner" tabindex="-1" autofocus>
      <p class="label">条目 {entryNumber(index)} · 就地预览</p>
      <h2 class="preview__title" id={`${previewId}-title`}>{project.title}</h2>

      <h3 class="preview__h">架构</h3>
      <pre class="preview__arch">{project.preview.architecture}</pre>

      <h3 class="preview__h">实现难点</h3>
      <ul class="preview__list">
        {project.preview.challenges.map((item) => <li>{item}</li>)}
      </ul>

      <h3 class="preview__h">心得</h3>
      <ul class="preview__list">
        {project.preview.lessons.map((item) => <li>{item}</li>)}
      </ul>

      <div class="preview__foot">
        {/* 关闭按钮是 type="button" + 脚本调 close()，刻意不用 <form method="dialog">：
            页面 CSP 里 form-action 是 'none'，而那是一条会被浏览器执行到的指令 ——
            没必要为了省几行脚本去赌它不会拦下一个不触发导航的表单。 */}
        <button type="button" class="btn" data-preview-close>关闭预览</button>
      </div>
    </div>
  </dialog>

  {/* hover 时掠过卡片的一道微光；只在真的能 hover 的设备上跑 */}
  <span class="sheen" aria-hidden="true"></span>
</article>
