---
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../data/site';
import { DEFAULT_THEME, THEME_BOOT_SCRIPT } from '../lib/theme';

interface Props {
  /** 页面标题（不含站点名）；不传则用「站名 · 副题」 */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** 详情页用条目自己的强调色，让整页的标记与线条跟着走 */
  accent?: 'coral' | 'teal' | 'amber';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = SITE.description, ogType = 'website', accent, jsonLd, noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.subtitle}`;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
{/*
  默认主题直接渲染在 <html> 上，而不是靠 CSS 的 prefers-color-scheme 猜：
  这样 JS 被禁用、或引导脚本被 CSP 拦掉时，看到的仍然是新粗野主义，
  而不是"跟随系统的某个样子"。引导脚本只在用户手动选过之后才覆盖它。
*/}
<html lang={SITE.lang} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="stylesheet" href="/plate-sizes.css" />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author.handle} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} —— ${SITE.subtitle}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* 地址栏配色跟随**默认主题**的画布色（新粗野主义的 --c-canvas）。
        手动切到浅 / 深时它不会跟着走：那要多一段改 meta 的脚本，不值得 ——
        README 的「已知限制」里有记。 */}
    <meta name="theme-color" content="#fffdf4" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      主题引导：必须同步执行、且在样式生效之前 —— 它把上面那个服务端渲染的
      默认主题按 localStorage 覆盖掉，所以切换过的访客不会先闪一下粗野主义。
      这是唯一由我们手工登记哈希的内联脚本（见 src/lib/csp.ts）：通过 set:html
      注入的脚本，Astro 不会替它生成哈希。
    */}
    <script is:inline set:html={THEME_BOOT_SCRIPT}></script>

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')}></script>
      ))
    }
  </head>

  <body class={accent ? `accent-${accent}` : undefined}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
